# Copy to server/.env and keep that file out of git.
# chmod 600 server/.env

# ========================================================
# NETWORK & APP CONFIGURATION
# ========================================================
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://127.0.0.1:3000
ALLOWED_ORIGIN=http://127.0.0.1:3000
TRUST_PROXY=false

# demo: pick a seeded @company.com colleague (local only)
# password: require DEMO_PASSWORD in addition to the corporate email
AUTH_MODE=demo
DEMO_PASSWORD=replace-with-a-long-secret
# Slide seed departure times forward on boot so the board stays in the future.
DEMO_REFRESH_SCHEDULE=true

# HMAC secret for HttpOnly session cookies. Use 32+ random bytes in production.
SESSION_SECRET=replace-with-a-32-byte-random-secret

# Set true behind HTTPS so cookies carry the Secure flag.
COOKIE_SECURE=false

# ========================================================
# DATABASE CONNECTION POOL
# ========================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=commutepool_app
DB_PASS=replace-with-a-strong-secret
DB_NAME=commutepool
# Clamped to 10-25 connections at runtime.
DB_CONNECTION_LIMIT=20
DB_QUEUE_LIMIT=0

# ========================================================
# COMPANY OFFICE DEFAULTS
# ========================================================
OFFICE_NAME=Campus HQ Tower B
OFFICE_ADDRESS=Global Technology Park, Bellandur, Bengaluru, KA 560103
TIMEZONE=Asia/Kolkata

# ========================================================
# LOGGING & AUDIT
# ========================================================
LOG_LEVEL=info
LOG_PATH=
